# ============================================================
# Baby Talk — Docker Compose 环境变量模板
# 使用方法: cp .env.example .env  然后按需修改
# ============================================================

# --- JWT / Auth（REQUIRED — 缺失时 Spring Boot fail-fast） ---
# v1.2.0.1 起移除硬编码 fallback；必须显式设置，不能留空
# 要求：至少 32 个字符高熵随机串；本地开发可使用下方占位值，生产必须替换
BABY_TALK_ADMIN_JWT_SECRET=change-me-admin-dev-hs256-secret-32-chars
BABY_TALK_CONSUMER_JWT_SECRET=change-me-consumer-dev-hs256-secret-32-chars
# Gateway CORS 允许的 admin-web origin（本地 Vite 默认 5173）
BABY_TALK_ADMIN_WEB_ORIGIN=http://localhost:5173

# --- AI / LLM ---
# Mentor & 知识图谱所使用的 AI 服务端点、密钥、模型
BABY_TALK_AI_BASE_URL=https://models.inference.ai.azure.com
BABY_TALK_AI_API_KEY=
BABY_TALK_AI_MODEL=gpt-4o-mini

# --- Embedding ---
# 向量嵌入服务（语义搜索）
BABY_TALK_EMBEDDING_BASE_URL=https://models.inference.ai.azure.com
BABY_TALK_EMBEDDING_API_KEY=
BABY_TALK_EMBEDDING_MODEL=text-embedding-3-small
BABY_TALK_EMBEDDING_DIMENSIONS=1536

# --- Mentor ---
# 搜索模式: none | embedding | keyword
BABY_TALK_MENTOR_SEARCH_MODE=none
# 多轮会话超时时间（ISO 8601 Duration）
BABY_TALK_MENTOR_SESSION_TIMEOUT=PT30M
# 练习场景回复最大长度
BABY_TALK_MENTOR_PRACTICE_RESPONSE_MAX_LENGTH=2000

# --- Knowledge Graph Review ---
# 本地开发默认关闭 KG 审查；生产环境建议设为 true
BABY_TALK_KG_REVIEW_ENABLED=false
# 审查轮询间隔
BABY_TALK_KG_REVIEW_INTERVAL=PT5M
# 每次审查批量大小
BABY_TALK_KG_REVIEW_BATCH_SIZE=10
